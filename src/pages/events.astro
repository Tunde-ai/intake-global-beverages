---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Events — InTake Beverages LLC">
  <Header />

  <section class="events">
    <div class="events__bg"></div>
    <div class="events__overlay"></div>

    <div class="events__content container">
      <h1 class="events__heading">EVENTS</h1>
      <p class="events__subtext">Upcoming experiences from InTake Global & Beverages</p>

      <!-- ═══ Flyer ═══ -->
      <div class="event-flyer" id="paris-fashion-week">
        <img
          src="/intake-global-beverages/assets/events/paris-fashion-week-2027.jpeg"
          alt="InTake Global & Beverages — Inaugural Paris Fashion Week Global Brunch, Premiere & Showcase — Sunday, June 27, 2027"
          class="event-flyer__img"
        />
      </div>

      <!-- ═══ Details + RSVP ═══ -->
      <div class="event-bottom">
        <div class="event-card__details">
          <div class="event-card__glass">
            <h2 class="event-card__title">Inaugural Paris Fashion Week</h2>
            <p class="event-card__subtitle">Global Brunch, Premiere & Showcase</p>

            <div class="event-card__info">
              <div class="event-card__info-row">
                <span class="event-card__label">DATE</span>
                <span class="event-card__value">Sunday, June 27, 2027</span>
              </div>
              <div class="event-card__info-row">
                <span class="event-card__label">TIME</span>
                <span class="event-card__value">11:00 AM – 3:00 PM</span>
              </div>
              <div class="event-card__info-row">
                <span class="event-card__label">VENUE</span>
                <span class="event-card__value">To be announced with invitation</span>
              </div>
              <div class="event-card__info-row">
                <span class="event-card__label">DRESS</span>
                <span class="event-card__value">All-white attire</span>
              </div>
              <div class="event-card__info-row">
                <span class="event-card__label">RSVP BY</span>
                <span class="event-card__value">March 29, 2027</span>
              </div>
            </div>

            <div class="event-card__highlights">
              <h3 class="event-card__highlights-title">Program Highlights</h3>
              <ul class="event-card__highlights-list">
                <li>InTake brunch reception</li>
                <li>Premiere presentation of InTake Energy + Water — Apricot Mist</li>
                <li>Product showcase & sampling</li>
                <li>Networking & media preview</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="rsvp" id="rsvp">
          <div class="rsvp__glass">
          <h2 class="rsvp__heading">RSVP</h2>
          <p class="rsvp__note">Reserve your spot for the Paris Fashion Week event.</p>

          <form class="rsvp__form" id="rsvp-form">
            <div class="rsvp__row">
              <div class="rsvp__field">
                <label for="rsvp-first" class="rsvp__label">First Name</label>
                <input type="text" id="rsvp-first" name="first_name" required class="rsvp__input" placeholder="First name">
              </div>
              <div class="rsvp__field">
                <label for="rsvp-last" class="rsvp__label">Last Name</label>
                <input type="text" id="rsvp-last" name="last_name" required class="rsvp__input" placeholder="Last name">
              </div>
            </div>

            <div class="rsvp__row">
              <div class="rsvp__field">
                <label for="rsvp-email" class="rsvp__label">Email</label>
                <input type="email" id="rsvp-email" name="email" required class="rsvp__input" placeholder="you@example.com">
              </div>
              <div class="rsvp__field">
                <label for="rsvp-phone" class="rsvp__label">Phone (optional)</label>
                <input type="tel" id="rsvp-phone" name="phone" class="rsvp__input" placeholder="+1 (555) 000-0000">
              </div>
            </div>

            <div class="rsvp__row">
              <div class="rsvp__field">
                <label for="rsvp-tickets" class="rsvp__label">Number of Tickets</label>
                <select id="rsvp-tickets" name="tickets" required class="rsvp__input rsvp__select">
                  <option value="" disabled selected>Select</option>
                  <option value="1">1 Ticket</option>
                  <option value="2">2 Tickets</option>
                  <option value="3">3 Tickets</option>
                  <option value="4">4 Tickets</option>
                  <option value="5+">5+ Tickets</option>
                </select>
              </div>
              <div class="rsvp__field">
                <label for="rsvp-event" class="rsvp__label">Event</label>
                <select id="rsvp-event" name="event" required class="rsvp__input rsvp__select">
                  <option value="paris-fashion-week-2027" selected>Paris Fashion Week — June 27, 2027</option>
                </select>
              </div>
            </div>

            <div class="rsvp__field rsvp__field--full">
              <label for="rsvp-message" class="rsvp__label">Message (optional)</label>
              <textarea id="rsvp-message" name="message" rows="3" class="rsvp__input rsvp__textarea" placeholder="Dietary preferences, accessibility needs, or questions..."></textarea>
            </div>

            <button type="submit" class="rsvp__submit">SUBMIT RSVP</button>
          </form>

          <div class="rsvp__confirmation" id="rsvp-confirmation" style="display:none;">
            <p class="rsvp__success">Thank you! Your RSVP has been received.</p>
            <p class="rsvp__followup">A confirmation will be sent to your email. For questions, contact <a href="mailto:info@intakeglobal.com" class="rsvp__email">info@intakeglobal.com</a></p>
          </div>

          <p class="rsvp__contact">Or email <a href="mailto:info@intakeglobal.com" class="rsvp__email">info@intakeglobal.com</a> directly for inquiries and group reservations.</p>
        </div>
        </div>
      </div>

      <!-- Future events slot -->
      <div class="events__more">
        <p class="events__more-text">More events coming soon. Stay tuned.</p>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('rsvp-form');
  const confirmation = document.getElementById('rsvp-confirmation');
  if (form && confirmation) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const subject = encodeURIComponent(`RSVP — ${data.get('event')}`);
      const body = encodeURIComponent(
        `Name: ${data.get('first_name')} ${data.get('last_name')}\n` +
        `Email: ${data.get('email')}\n` +
        `Phone: ${data.get('phone') || 'N/A'}\n` +
        `Tickets: ${data.get('tickets')}\n` +
        `Event: ${data.get('event')}\n` +
        `Message: ${data.get('message') || 'N/A'}`
      );
      window.location.href = `mailto:info@intakeglobal.com?subject=${subject}&body=${body}`;
      form.style.display = 'none';
      confirmation.style.display = 'block';
    });
  }
</script>

<style>
.events {
  position: relative;
  min-height: 100vh;
  padding: 120px 0 80px;
}
.events__bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #050a19 0%, #0a1628 50%, #050a19 100%);
}
.events__overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse 80% 50% at 50% 30%,
    rgba(72, 159, 180, 0.06) 0%,
    transparent 70%
  );
}
.events__content {
  position: relative;
  z-index: 2;
}
.events__heading {
  font-family: var(--font-heading);
  font-size: 72px;
  font-weight: 400;
  letter-spacing: 12px;
  color: var(--white);
  text-align: center;
  margin-bottom: 0.25rem;
}
.events__subtext {
  font-family: var(--font-body);
  font-size: 18px;
  font-style: italic;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 3rem;
}

/* ═══ Flyer ═══ */
.event-flyer {
  max-width: 1100px;
  margin: 0 auto 2.5rem;
  aspect-ratio: 16 / 9;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.event-flyer__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  background: #0a1628;
}

/* ═══ Details + RSVP Row ═══ */
.event-bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  max-width: 1100px;
  margin: 0 auto 3rem;
  align-items: stretch;
}
.event-card__details {
  display: flex;
}
.event-card__glass {
  flex: 1;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.10) 0%,
    rgba(255, 255, 255, 0.03) 50%,
    rgba(255, 255, 255, 0.01) 75%,
    rgba(255, 255, 255, 0.05) 100%
  );
  backdrop-filter: blur(16px) saturate(1.2);
  -webkit-backdrop-filter: blur(16px) saturate(1.2);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  padding: 2rem;
}
.event-card__title {
  font-family: var(--font-heading);
  font-size: 36px;
  font-weight: 400;
  letter-spacing: 4px;
  color: var(--white);
  margin-bottom: 0.25rem;
}
.event-card__subtitle {
  font-family: var(--font-body);
  font-size: 16px;
  font-style: italic;
  color: #489FB4;
  letter-spacing: 1px;
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.event-card__info {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}
.event-card__info-row {
  display: flex;
  gap: 1rem;
  align-items: baseline;
}
.event-card__label {
  font-family: var(--font-heading);
  font-size: 14px;
  letter-spacing: 3px;
  color: #489FB4;
  min-width: 90px;
}
.event-card__value {
  font-family: var(--font-body);
  font-size: 15px;
  color: rgba(255, 255, 255, 0.85);
}
.event-card__highlights {
  padding-top: 1.25rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}
.event-card__highlights-title {
  font-family: var(--font-heading);
  font-size: 18px;
  letter-spacing: 3px;
  color: var(--white);
  margin-bottom: 0.75rem;
}
.event-card__highlights-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.event-card__highlights-list li {
  font-family: var(--font-body);
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  padding-left: 1.25rem;
  position: relative;
}
.event-card__highlights-list li::before {
  content: '◆';
  position: absolute;
  left: 0;
  color: #489FB4;
  font-size: 8px;
  top: 4px;
}

/* ═══ RSVP Form ═══ */
.rsvp {
  display: flex;
}
.rsvp__glass {
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.08) 0%,
    rgba(255, 255, 255, 0.02) 50%,
    rgba(255, 255, 255, 0.01) 75%,
    rgba(255, 255, 255, 0.04) 100%
  );
  backdrop-filter: blur(16px) saturate(1.2);
  -webkit-backdrop-filter: blur(16px) saturate(1.2);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 2.5rem;
}
.rsvp__heading {
  font-family: var(--font-heading);
  font-size: 42px;
  font-weight: 400;
  letter-spacing: 8px;
  color: var(--white);
  text-align: center;
  margin-bottom: 0.25rem;
}
.rsvp__note {
  font-family: var(--font-body);
  font-size: 15px;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 2rem;
}
.rsvp__form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.rsvp__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}
.rsvp__field {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.rsvp__field--full {
  grid-column: 1 / -1;
}
.rsvp__label {
  font-family: var(--font-heading);
  font-size: 13px;
  letter-spacing: 2px;
  color: rgba(255, 255, 255, 0.6);
}
.rsvp__input {
  font-family: var(--font-form);
  font-size: 15px;
  color: var(--white);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  padding: 12px 14px;
  outline: none;
  transition: border-color 0.2s, background 0.2s;
}
.rsvp__input::placeholder {
  color: rgba(255, 255, 255, 0.25);
}
.rsvp__input:focus {
  border-color: #489FB4;
  background: rgba(72, 159, 180, 0.06);
}
.rsvp__select {
  appearance: none;
  background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='rgba(255,255,255,0.4)' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 14px center;
  padding-right: 36px;
  cursor: pointer;
}
.rsvp__select option {
  background: #1a1a2e;
  color: var(--white);
}
.rsvp__textarea {
  resize: vertical;
  min-height: 80px;
}
.rsvp__submit {
  font-family: var(--font-heading);
  font-size: 20px;
  letter-spacing: 5px;
  color: var(--white);
  background: linear-gradient(135deg, rgba(72, 159, 180, 0.4), rgba(72, 159, 180, 0.2));
  border: 1px solid rgba(72, 159, 180, 0.5);
  border-radius: 30px;
  padding: 14px 40px;
  cursor: pointer;
  transition: background 0.3s, transform 0.2s;
  margin-top: 0.5rem;
  align-self: center;
}
.rsvp__submit:hover {
  background: linear-gradient(135deg, rgba(72, 159, 180, 0.55), rgba(72, 159, 180, 0.35));
  transform: translateY(-2px);
}
.rsvp__confirmation {
  text-align: center;
  padding: 2rem 0;
}
.rsvp__success {
  font-family: var(--font-heading);
  font-size: 28px;
  letter-spacing: 3px;
  color: #489FB4;
  margin-bottom: 0.75rem;
}
.rsvp__followup {
  font-family: var(--font-body);
  font-size: 15px;
  color: rgba(255, 255, 255, 0.6);
}
.rsvp__contact {
  font-family: var(--font-body);
  font-size: 14px;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  margin-top: 1.5rem;
}
.rsvp__email {
  color: #489FB4;
  text-decoration: none;
  transition: color 0.2s;
}
.rsvp__email:hover {
  color: var(--white);
}

/* ═══ Future Events ═══ */
.events__more {
  text-align: center;
  padding: 2rem 0;
}
.events__more-text {
  font-family: var(--font-body);
  font-size: 15px;
  color: rgba(255, 255, 255, 0.3);
  font-style: italic;
}

/* ═══ Mobile ═══ */
@media (max-width: 768px) {
  .events__heading { font-size: 48px; letter-spacing: 8px; }
  .event-bottom {
    grid-template-columns: 1fr;
  }
  .event-card__title { font-size: 28px; }
  .rsvp__row { grid-template-columns: 1fr; }
  .rsvp__glass { padding: 1.5rem; }
  .rsvp__heading { font-size: 32px; }
}

/* ═══ Landscape Mobile ═══ */
@media (max-height: 500px) and (orientation: landscape) {
  .events { padding: 70px 0 40px; }
  .events__heading { font-size: 36px; letter-spacing: 6px; }
  .event-card__title { font-size: 24px; }
  .rsvp__glass { padding: 1.25rem; }
}
</style>
