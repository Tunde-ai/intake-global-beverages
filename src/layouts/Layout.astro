---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "InTake Global & Beverages — luxury energy drinks crafted for hydration, performance, and lifestyle." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;1,700&family=Bebas+Neue&family=Raleway:ital,wght@1,300;1,400&family=Goldman&family=Montserrat:wght@400;500&family=Poppins:wght@400;500&family=Source+Sans+3:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Splash Screen -->
  <div class="splash" id="splash">
    <div class="splash__content">
      <img src="/intake-global-beverages/assets/logos/intake-global-bold.png" alt="InTake Global & Beverages" class="splash__logo">
      <div class="splash__loader">
        <div class="splash__bar">
          <div class="splash__fill" id="splash-fill">
            <div class="splash__wave"></div>
          </div>
        </div>
        <div class="splash__drops" id="splash-drops">
          <span class="splash__drop splash__drop--1"></span>
          <span class="splash__drop splash__drop--2"></span>
          <span class="splash__drop splash__drop--3"></span>
          <span class="splash__drop splash__drop--4"></span>
          <span class="splash__drop splash__drop--5"></span>
          <span class="splash__drop splash__drop--6"></span>
          <span class="splash__drop splash__drop--7"></span>
        </div>
      </div>
    </div>
  </div>

  <a href="#mission" class="skip-link">Skip to content</a>
  <slot />
  <script src="../scripts/main.js"></script>
</body>
</html>

<style is:global>
/* ═══ Tokens ═══ */
:root {
  --white: #FFFFFF;
  --accent-cyan: #43B7CD;
  --accent-yellow: #D9DA48;
  --hero-overlay: rgba(15, 39, 87, 0.5);
  --overlay-black: rgba(0, 0, 0, 0.5);
  --overview-overlay: rgba(2, 2, 2, 0.5);
  --panel-dark: rgba(0, 0, 0, 0.7);
  --paris-fallback: #424EB4;
  --overview-fallback: #002200;
  --footer-grad-top: #091730;
  --footer-grad-bottom: #000000;
  --divider-light: rgba(255, 255, 255, 0.42);
  --column-rule: rgba(255, 255, 255, 0.39);
  --input-text: #7A7A7A;
  --scrolltop: #046BD2;
  --font-heading: 'Bebas Neue', cursive;
  --font-body: 'Source Sans 3', sans-serif;
  --font-accent: 'Montserrat', sans-serif;
  --font-form: 'Poppins', sans-serif;
  --container-max: 1200px;
}

/* ═══ Reset ═══ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  color: var(--white);
  background: #000;
  overflow-x: hidden;
}
a { color: var(--white); text-decoration: none; }
img { max-width: 100%; height: auto; display: block; }
ul { list-style: none; }

.container {
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  padding-inline: 2rem;
}

.skip-link {
  position: absolute;
  top: -100%;
  left: 0;
  background: var(--accent-cyan);
  color: #000;
  padding: 0.5rem 1rem;
  z-index: 200;
  font-family: var(--font-form);
}
.skip-link:focus { top: 0; }

/* ═══ Splash Screen ═══ */
.splash {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.8s ease;
}
.splash__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2.5rem;
}
.splash__logo {
  width: 1000px;
  max-width: 90%;
  height: auto;
}
.splash__loader {
  position: relative;
  width: 280px;
}
.splash__bar {
  width: 100%;
  height: 8px;
  background: #e8f4f7;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}
.splash__fill {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, #489FB4, #43B7CD, #68d4e8);
  border-radius: 4px;
  position: relative;
  animation: splash-fill 2.2s ease-in-out forwards;
  overflow: visible;
}
.splash__wave {
  position: absolute;
  right: -2px;
  top: -6px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(67, 183, 205, 0.6) 0%, transparent 70%);
  animation: splash-wave-pulse 0.4s ease-in-out infinite alternate;
}

/* Water drops that splash out at the end */
.splash__drops {
  position: absolute;
  top: -4px;
  right: 0;
  left: 0;
  width: 100%;
  height: 60px;
  pointer-events: none;
  opacity: 0;
}
.splash__drops.is-splashing {
  opacity: 1;
}
.splash__drop {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #43B7CD;
  opacity: 0;
}
.splash__drops.is-splashing .splash__drop {
  animation: splash-drop 0.7s ease-out forwards;
}
.splash__drop--1 { left: 50%; animation-delay: 0s; --dx: -40px; --dy: -35px; }
.splash__drop--2 { left: 55%; animation-delay: 0.05s; --dx: 30px; --dy: -40px; width: 4px; height: 4px; }
.splash__drop--3 { left: 45%; animation-delay: 0.08s; --dx: -25px; --dy: -25px; width: 5px; height: 5px; }
.splash__drop--4 { left: 60%; animation-delay: 0.03s; --dx: 45px; --dy: -30px; width: 3px; height: 3px; }
.splash__drop--5 { left: 40%; animation-delay: 0.1s; --dx: -50px; --dy: -20px; width: 4px; height: 4px; }
.splash__drop--6 { left: 52%; animation-delay: 0.06s; --dx: 15px; --dy: -45px; width: 5px; height: 5px; }
.splash__drop--7 { left: 48%; animation-delay: 0.04s; --dx: -10px; --dy: -38px; width: 3px; height: 3px; }

@keyframes splash-fill {
  0% { width: 0%; }
  70% { width: 85%; }
  100% { width: 100%; }
}
@keyframes splash-wave-pulse {
  0% { transform: scale(0.8); opacity: 0.5; }
  100% { transform: scale(1.3); opacity: 1; }
}
@keyframes splash-drop {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
  60% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(0.3);
  }
}
.splash.is-closing {
  opacity: 0;
  pointer-events: none;
}
.splash.is-hidden {
  display: none;
}

/* Landscape mobile */
@media (max-height: 500px) and (orientation: landscape) {
  .splash__logo { width: 400px; }
  .splash__loader { width: 200px; }
  .splash__content { gap: 1.5rem; }
}

/* ═══ Animations ═══ */
.fade-in,
.fade-in-up {
  opacity: 0;
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.fade-in-up { transform: translateY(30px); }
.fade-in.is-visible,
.fade-in-up.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .fade-in, .fade-in-up {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* ═══ Scroll to Top ═══ */
.scroll-top {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  width: 32px;
  height: 32px;
  background: var(--scrolltop);
  color: var(--white);
  border: none;
  border-radius: 2px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  z-index: 90;
}
.scroll-top.is-visible {
  opacity: 1;
  pointer-events: auto;
}
</style>
